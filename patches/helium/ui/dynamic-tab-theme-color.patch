+
+std::optional<SkColor> BrowserView::GetDynamicTabThemeColorFor(
+    content::WebContents* contents) const {
+  if (!contents || !contents->GetVisibleURL().SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+
+  // 1) Preferred source: <meta name="theme-color">.
+  if (auto theme_color = contents->GetThemeColor()) {
+    return theme_color;
+  }
+
+  // 2) Fallback: page base background color.
+  if (auto background = contents->GetBackgroundColor()) {
+    return background;
+  }
+
+  // 3) Last resort: dominant favicon color.
+  auto* favicon_driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+  if (favicon_driver) {
+    const gfx::Image& favicon = favicon_driver->GetFavicon();
+    if (!favicon.IsEmpty()) {
+      const SkBitmap* bitmap = favicon.ToSkBitmap();
+      if (bitmap && !bitmap->drawsNothing()) {
+        return color_utils::CalculateKMeanColorOfBitmap(*bitmap);
+      }
+    }
+  }
+
+  return std::nullopt;
+}
+
+void BrowserView::UpdateDynamicTabThemeColor() {
+  if (!browser_ || browser_->profile()->IsOffTheRecord()) {
+    return;
+  }
+
+  if (!browser_->profile()->GetPrefs()->GetBoolean(
+          prefs::kDynamicTabThemeColorEnabled)) {
+    frame_->ClearFrameColorOverride();
+    return;
+  }
+
+  content::WebContents* active_contents = GetActiveWebContents();
+  const std::optional<SkColor> dynamic_color =
+      GetDynamicTabThemeColorFor(active_contents);
+
+  if (!dynamic_color.has_value()) {
+    frame_->ClearFrameColorOverride();
+    return;
+  }
+
+  // Apply only on user web pages (not browser-managed pages).
+  if (!active_contents->GetVisibleURL().SchemeIsHTTPOrHTTPS()) {
+    frame_->ClearFrameColorOverride();
+    return;
+  }
+
+  frame_->SetFrameColorOverride(*dynamic_color);
+}
